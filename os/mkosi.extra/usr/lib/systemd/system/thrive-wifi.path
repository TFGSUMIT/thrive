# thriveOS: watch for thrive Wi-Fi requests (scan/connect/forget). When the API
# drops a request-wifi-<verb> file into the (host-side) control dir, fire
# thrive-wifi.service to act on it. Path units watch the nearest existing
# ancestor, so this is safe before thrive-wifi-init creates the control dir.
[Unit]
Description=Watch for thrive Wi-Fi requests

[Path]
PathExistsGlob=/opt/thrive/trunk/data/control/request-wifi-*
Unit=thrive-wifi.service

[Install]
WantedBy=multi-user.target
