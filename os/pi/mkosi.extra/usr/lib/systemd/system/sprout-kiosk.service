[Unit]
Description=Sprout kiosk — thrive UI fullscreen (cage + chromium)
# Only the `user` image runs the kiosk: its cmdline carries `splash` (PROFILE=user
# in build.sh); the `dev` image has no `splash`, so this is skipped and you get a
# normal console login instead.
ConditionKernelCommandLine=splash
# wait for the stack; on first boot thrive builds for minutes (the ExecStartPre
# below also polls :9500 so we don't flash a connection-refused page)
Wants=thrive.service
After=thrive.service systemd-user-sessions.service plymouth-quit-wait.service
# take tty1 from the console getty
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
Type=simple
User=thrive
# Pi 5 splits the GPU: card0=v3d (render-only), card1=vc4 (display). Point wlroots
# at the display card, else cage finds no outputs and exits (black screen / loop).
Environment=WLR_DRM_DEVICES=/dev/dri/card1
# cage draws a cursor at screen-centre regardless of any pointer; the only way to
# hide it on a touch wall is a blank Xcursor theme (built in mkosi.postinst, kiosk
# only). Force the software cursor so the theme actually takes effect.
Environment=XCURSOR_THEME=blank
Environment=XCURSOR_SIZE=24
Environment=XCURSOR_PATH=/usr/share/icons:/usr/share/pixmaps
Environment=WLR_NO_HARDWARE_CURSORS=1
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
ExecStartPre=/usr/local/bin/sprout-kiosk-wait
ExecStart=/usr/bin/cage -- /usr/local/bin/sprout-kiosk-browser
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
