#!/usr/bin/env bash
# Pi-4 variant of ../mkosi.postinst — same machinery (runs on the HOST with
# $BUILDROOT = image root; enable units via wants-symlinks, create the default
# user by writing passwd/shadow directly), minus the desktop (headless image)
# and with sprout-grow replacing systemd-repart (no GPT on the Pi → repart
# can't grow an MBR root; growpart+resize2fs on first boot does instead).
set -euo pipefail

R="$BUILDROOT"

enable_unit() {
    local unit="$1" target="${2:-multi-user.target}" src="" wd="$R/etc/systemd/system/${2:-multi-user.target}.wants"
    mkdir -p "$wd"
    for d in /usr/lib/systemd/system /lib/systemd/system /etc/systemd/system /usr/local/lib/systemd/system; do
        if [ -e "$R$d/$unit" ]; then src="$d/$unit"; break; fi
    done
    if [ -n "$src" ]; then
        ln -sf "$src" "$wd/$unit"
        echo "[postinst] enabled $unit -> $src (in $target)"
    else
        echo "[postinst] WARN: $unit not found in image"
    fi
}

enable_unit docker.service     # container engine
enable_unit ssh.service        # remote admin
enable_unit thrive.service     # the appliance: pulls the thrive repo + runs trunk/
enable_unit sprout-grow.service  # grow root to fill the SD card on first boot (MBR-safe)

# power controls (#39): host-side watcher for Settings → Power (reboot/poweroff/
# restart-stack/relaunch-kiosk). thrive-power.service is triggered by the .path,
# not enabled directly. The marker it drops surfaces the buttons in thrive.
enable_unit thrive-power.path
enable_unit thrive-power-init.service
# kiosk-vs-desktop session is decided at the END of this script, keyed on whether the
# `desktop` profile installed lightdm — so the two editions never clobber each other.

# networking: systemd-networkd wired DHCP + resolved (shared 20-dhcp.network overlay)
enable_unit systemd-networkd.service
enable_unit systemd-networkd.socket              sockets.target
enable_unit systemd-networkd-wait-online.service network-online.target
enable_unit systemd-resolved.service
ln -sf /run/systemd/resolve/stub-resolv.conf "$R/etc/resolv.conf"

# --- default appliance login: thrive / growth (sudo-capable) ------------------
# Same dev-default credentials as the amd64 image; change for any real deploy.
if ! grep -q '^thrive:' "$R/etc/passwd"; then
    echo 'thrive:x:1000:1000:thrive appliance admin:/home/thrive:/bin/bash' >> "$R/etc/passwd"
    echo 'thrive:$6$sproutv1$azy5OZ0XW/YOufw3lOwF5nHD.MxsAtEOIXaaH6P2.Zhk9Dejq54xvEOPNwyc5YmXMTGFwTTSJw.YFVmFrFjcd0:20000:0:99999:7:::' >> "$R/etc/shadow"
    echo 'thrive:x:1000:' >> "$R/etc/group"
    echo 'thrive:!::'     >> "$R/etc/gshadow"
    # sudo (admin) + video/input/render so cage/seatd can open the GPU + input on the kiosk
    awk -F: 'BEGIN{OFS=":"} $1=="sudo"||$1=="video"||$1=="input"||$1=="render"{ if($4=="") $4="thrive"; else $4=$4",thrive" } {print}' \
        "$R/etc/group" > "$R/etc/group.tmp" && mv "$R/etc/group.tmp" "$R/etc/group"
    mkdir -p "$R/home/thrive"
    cp -aT "$R/etc/skel" "$R/home/thrive" 2>/dev/null || true
    chown -R 1000:1000 "$R/home/thrive"
    chmod 700 "$R/home/thrive"
    echo "[postinst] created default user thrive (sudo + video/input/render)"
fi

# --- session: desktop if the `desktop` profile installed lightdm, else kiosk ----
if [ -e "$R/usr/sbin/lightdm" ] || [ -e "$R/usr/bin/lightdm" ]; then
    # DESKTOP edition: boot graphical → LightDM autologin → XFCE. Autologin +
    # branding + the thrive launcher come from the shared ../mkosi.extra overlay.
    ln -sf /usr/lib/systemd/system/graphical.target "$R/etc/systemd/system/default.target"
    ln -sf /usr/lib/systemd/system/lightdm.service  "$R/etc/systemd/system/display-manager.service"
    enable_unit lightdm.service graphical.target
    echo "[postinst] pi DESKTOP: graphical.target + lightdm"
else
    # KIOSK edition (default): headless multi-user + the cage/chromium kiosk.
    enable_unit sprout-kiosk.service # Pi-on-a-TV → fullscreen thrive UI; self-gates on
                                     # the `splash` cmdline (only runs in the `user` image)
    ln -sf /usr/lib/systemd/system/multi-user.target "$R/etc/systemd/system/default.target"
    # blank Xcursor theme (transparent at 24/32/48/64) so cage's centre cursor is
    # invisible on the touch wall — paired with XCURSOR_THEME=blank in sprout-kiosk.service.
    mkdir -p "$R/usr/share/icons/blank/cursors" "$R/usr/share/icons/default"
    python3 - "$R/usr/share/icons/blank/cursors/left_ptr" <<'PY'
import struct, sys
le = lambda v: struct.pack('<I', v)
sizes = [24, 32, 48, 64]
imgs = [(s, le(36)+le(0xfffd0002)+le(s)+le(1)+le(s)+le(s)+le(s//2)+le(s//2)+le(0)+b'\x00'*(s*s*4)) for s in sizes]
hdr = b'Xcur' + le(16) + le(0x10000) + le(len(imgs))
pos = 16 + len(imgs)*12; positions = []
for s, img in imgs: positions.append(pos); pos += len(img)
toc = b''.join(le(0xfffd0002)+le(s)+le(p) for (s, img), p in zip(imgs, positions))
open(sys.argv[1], 'wb').write(hdr + toc + b''.join(i for _, i in imgs))
PY
    for n in default arrow top_left_arrow xterm hand1 hand2 pointer watch text crosshair fleur; do ln -sf left_ptr "$R/usr/share/icons/blank/cursors/$n"; done
    printf '[Icon Theme]\nName=blank\n' > "$R/usr/share/icons/blank/index.theme"
    printf '[Icon Theme]\nName=Default\nInherits=blank\n' > "$R/usr/share/icons/default/index.theme"
    echo "[postinst] pi KIOSK: multi-user.target + sprout-kiosk + blank cursor"
fi
